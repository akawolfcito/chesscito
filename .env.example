# ── Login capacity (web / Privy) ───────────────────────────────────────
# The BUDGET for web logins, not a lock: Privy's own allowlist is what grants
# access. This only tells our client when to stop calling login(), because the
# Core plan is free to 499 MAU and $299/mo from 500.
# Server-only on purpose — never NEXT_PUBLIC_: a client-readable cap is a
# number a visitor can watch tick down.
# Both are OPTIONAL. Unset means: cap ON, limit 460 (39 seats of margin under
# 499, because the check cannot be transactional with Privy's counter).
# Set LOGIN_CAPACITY_ENABLED=false to reopen completely.
LOGIN_CAPACITY_LIMIT=
LOGIN_CAPACITY_ENABLED=

# ── Testing ────────────────────────────────────────────────────────────
# Throwaway wallet for driving wallet-gated flows (Ask Coach, badge claim,
# PRO chip) in dev and e2e. It holds NO funds and must NEVER hold any: it is
# for reaching UI branches that require a connected address, nothing else.
# Real value lives in .env (gitignored). Never paste it into a terminal, a
# commit, or a chat.
ONLY_TEST_NO_FUNDS_PK=0xREPLACE_ME_THROWAWAY_KEY_NO_FUNDS
