# RainbowKit Wallet Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Game server config (required for signing endpoints)
TORRE_PRINCESA=
DRAGON=

# Active chain for the live demo
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_SCOREBOARD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BADGES_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LABYRINTH_BADGES_ADDRESS=0x0000000000000000000000000000000000000000

# MiniPay fee currency override
NEXT_PUBLIC_MINIPAY_FEE_CURRENCY=

# Optional: set to 0 to hide raw tx debug tools in MiniPay
NEXT_PUBLIC_ENABLE_MINIPAY_RAWTX=1

# Optional: set to 1 to enable QA tools in play-hub (levelId override)
NEXT_PUBLIC_QA_MODE=0

# Optional: private RPC for Celo mainnet (defaults to forno.celo.org).
# Used by /api/leaderboard-rank and /api/founder-status to bypass
# Forno's unbounded eth_getLogs rate limits. Recommended for prod.
# Candidates: dRPC / Alchemy / QuickNode (free tiers cover current volume).
CELO_RPC_URL=

# Shop economy (USDC payments)
NEXT_PUBLIC_SHOP_ADDRESS=0x0000000000000000000000000000000000000000

# Shop deploy block on Celo mainnet. Used by /api/founder-status to bound
# eth_getLogs scans (Forno rejects unbounded "earliest" ranges).
# Match shopDeployedAt in apps/contracts/deployments/celo.json.
SHOP_DEPLOY_BLOCK_CELO=37800000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Production origin for API signing endpoint protection
# Set to your canonical domain (e.g. https://www.chesscito.com)
NEXT_PUBLIC_APP_URL=

# Gitcoin Passport gating (server-side only)
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=

# Coach — works with any OpenAI-compatible provider
# Feature flags
NEXT_PUBLIC_ENABLE_COACH=false

COACH_LLM_API_KEY=
COACH_LLM_MODEL=gpt-4o-mini
# COACH_LLM_BASE_URL=https://api.openai.com/v1
# COACH_LLM_BASE_URL=https://api.anthropic.com/v1/
# COACH_LLM_BASE_URL=https://api.deepseek.com

# Support email (shown in /support and /privacy pages)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Upstash Redis (required for Coach)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (derived data: practice logs, coach summaries, progress snapshots, Hall index)
# Server-side only — do NOT prefix with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lite Mode — set to "true" in the Chesscito Lite Vercel project.
# Full project must explicitly set this to "false".
# Default is off (false) — Full experience.
NEXT_PUBLIC_CHESSCITO_LITE_MODE=false

# Lite QA reset — server-only kill switch for the hidden /lite-debug/reset route.
# Never use a NEXT_PUBLIC_ prefix. Keep unset/false in normal production.
ENABLE_LITE_QA_RESET=false

# Optional public Lite local-progress namespace (e.g. qa-2026-06-21).
# Empty preserves the shipped v1 localStorage keys.
NEXT_PUBLIC_LITE_PROGRESS_VERSION=
